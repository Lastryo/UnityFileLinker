{
  "name": "unityfilelinker",
  "displayName": "UnityFileLinker",
  "description": "Unity File Linker automatically keeps Unity-generated .csproj files in sync with C# scripts and .asmdef files.",
  "publisher": "lastryo",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lastryo/UnityFileLinker"
  },
  "bugs": {
    "url": "https://github.com/Lastryo/UnityFileLinker/issues"
  },
  "homepage": "https://github.com/Lastryo/UnityFileLinker#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "icon": "Logo.png",
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "unity",
    "unity3d",
    "csharp",
    "csproj",
    "asmdef",
    "automation"
  ],
  "activationEvents": [
    "workspaceContains:ProjectSettings/ProjectVersion.txt"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "unityFileLinker.resyncProject",
        "title": "%command.resyncProject.title%",
        "category": "UnityFileLinker"
      }
    ],
    "configuration": {
      "title": "UnityFileLinker",
      "properties": {
        "unityFileLinker.showInfoNotifications": {
          "type": "boolean",
          "default": false,
          "description": "%config.showInfoNotifications.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "20.x",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3"
  }
}
