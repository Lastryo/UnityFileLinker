{
  "name": "unityfilelinker",
  "displayName": "UnityFileLinker",
  "description": "Unity File Linker automatically keeps Unity-generated .csproj files in sync with C# scripts and .asmdef files.",
  "publisher": "lastryo",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lastryo/UnityFileLinker"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "icon": "Logo.png",
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "unity",
    "csharp",
    "automation"
  ],
  "activationEvents": [
    "workspaceContains:ProjectSettings/ProjectVersion.txt",
    "workspaceContains:Assets"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "xml2js": "^0.4.23"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "20.x",
    "@types/vscode": "^1.95.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3"
  }
}
